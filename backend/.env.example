# Copy to .env and supply your own values. Never commit real credentials.
# server.js reads process environment; use Node --env-file=.env or a service manager.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=example_mahjong
DB_USER=example_mahjong_user
DB_PASSWORD=

# Optional administrator credentials used only by migrate-currencies.js.
# If omitted, the migration uses DB_USER and DB_PASSWORD.
# MIGRATION_DB_USER=example_migration_user
# MIGRATION_DB_PASSWORD=

PUBLIC_ORIGIN=https://example.com
COOKIE_SECURE=true
PORT=8771
